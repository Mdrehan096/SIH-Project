# RETRACK - RailSync-AI Global Environment Variables Example

# System & API
PROJECT_NAME="RETRACK - RailSync-AI"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Supabase & Database
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:yourpassword@db.your-supabase-project.supabase.co:5432/postgres

# Security & JWT
JWT_SECRET=retrack_railsync_ai_hackathon_super_secret_jwt_key_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Mapbox & Visualizations
MAPBOX_TOKEN=pk.your_mapbox_public_token

# Optimization Settings
SOLVER_TIME_LIMIT_SECONDS=10
SOLVER_SEED=42
