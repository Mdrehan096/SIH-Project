# RETRACK - RailSync-AI Environment Configuration Example

APP_NAME="RETRACK - RailSync-AI API"
APP_ENV="development"
APP_VERSION="1.0.0"

PORT=8000
HOST="0.0.0.0"

# MongoDB Database Configuration
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE="retrack_db"

# Supabase / PostgreSQL Configuration (Recommended for Live Database)
# 1. Obtain project credentials from your Supabase Dashboard -> Project Settings -> API & Database
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# 2. Direct PostgreSQL connection string (Supabase -> Settings -> Database -> Connection string)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres"

# Mapbox Map Token
MAPBOX_TOKEN="pk.eyJ1IjoicmFpbHN5bmMiLCJhIjoiY2xzemhkdWp6MHdpaTJrbjJpdGZxeGV0biJ9.dummy_mapbox_token"

# Configurable AI Provider & Model
AI_PROVIDER="google_gemini" # Options: google_gemini, openai, anthropic, custom
AI_API_KEY="demo-ai-api-key"
AI_MODEL="gemini-1.5-pro"

# Live Operations Simulation Engine
SIMULATION_ENABLED=true
SIMULATION_INTERVAL=10

# Security & JWT Authentication
JWT_SECRET="retrack_railsync_ai_hackathon_super_secret_jwt_key_2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Base URL for CORS
FRONTEND_URL="http://localhost:5173"
